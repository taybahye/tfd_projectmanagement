 "button_label": "Save",
 "client_script": "frappe.web_form.after_load = () => {\n     const params = new URLSearchParams(window.location.search);\n    \n        if (!params.get(\"_lang\")) {\n            params.set(\"_lang\", \"ar\");\n    \n            window.location.replace(\n                window.location.pathname + \"?\" + params.toString()\n            );\n            return;\n        }\n\n    const consent_field = \"custom_privacy_consents\";\n\n    function toggle_fields() {\n        const checked = frappe.web_form.get_value(consent_field);\n\n        // \u0625\u062e\u0641\u0627\u0621/\u0625\u0638\u0647\u0627\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u062d\u0642\u0648\u0644\n        Object.entries(frappe.web_form.fields_dict).forEach(([fieldname, field]) => {\n            if (!field) return;\n\n            // Checkbox \u064a\u0628\u0642\u0649 \u0638\u0627\u0647\u0631 \u062f\u0627\u0626\u0645\u064b\u0627\n            if (fieldname === consent_field) {\n                if (field.$wrapper) {\n                    field.$wrapper.show();\n                }\n                return;\n            }\n\n            if (field.$wrapper) {\n                if (checked) {\n                    field.$wrapper.show();\n                } else {\n                    field.$wrapper.hide();\n                }\n            }\n        });\n\n        // \u0625\u062e\u0641\u0627\u0621/\u0625\u0638\u0647\u0627\u0631 \u0639\u0646\u0627\u0648\u064a\u0646 \u0627\u0644\u0640 Sections\n        $(\".web-form .section-head, .web-form .section-title, .web-form .form-section\").each(function () {\n\n            // \u0644\u0627 \u0646\u062e\u0641\u064a section \u0627\u0644\u0630\u064a \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 checkbox\n            if ($(this).find(`[data-fieldname=\"${consent_field}\"]`).length) {\n                return;\n            }\n\n            if (checked) {\n                $(this).show();\n            } else {\n                // \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0639\u0646\u0635\u0631 container \u0643\u0628\u064a\u0631\u060c \u0646\u062e\u0641\u064a \u0641\u0642\u0637 \u0627\u0644\u0639\u0646\u0648\u0627\u0646\n                $(this).find(\".section-head, .section-title\").hide();\n            }\n        });\n\n        // \u0639\u0646\u062f \u0627\u0644\u062a\u0641\u0639\u064a\u0644 \u0623\u0639\u062f \u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646\n        if (checked) {\n            $(\".web-form .section-head, .web-form .section-title\").show();\n        }\n    }\n\n    // \u0639\u0646\u062f \u0641\u062a\u062d \u0627\u0644\u0635\u0641\u062d\u0629\n    setTimeout(() => {\n        toggle_fields();\n    }, 300);\n\n    // \u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 Checkbox\n    frappe.web_form.on(consent_field, function(field, value) {\n        toggle_fields();\n    });\n};",

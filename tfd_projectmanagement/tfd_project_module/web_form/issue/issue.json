 "client_script": "frappe.web_form.after_load = () => {\n    console.log(\"WEB FORM LOADED\");\n\n    const fields_to_toggle = [\n        \"custom_complainant_name\",\n        \"subject_section\",\n        \"custom_complainant_phone_number\",\n        \"subject\",\n        \"description\",\n        \"custom_gender\",\n        \"custom_complainant_phone_number\",\n        \"custom_marital_status\",\n        \"custom_governorate\",\n        \"subject\",\n        \"custom_district\",\n        \"custom_village\",\n        \"custom_date_of_incident\",\n        \"custom_age_group\",\n        \"issue_type\",\n        \"custom_complainant_status\",\n        \"custom_complaintant_name\"\n    ];\n\n    function toggle_fields() {\n        const consent = frappe.web_form.get_value(\"custom_privacy_consents\");\n\n        console.log(\"CONSENT VALUE:\", consent);\n\n        fields_to_toggle.forEach((fieldname) => {\n            const field = frappe.web_form.fields_dict[fieldname];\n\n            if (field) {\n                field.df.hidden = !consent;\n                field.refresh();\n            } else {\n                console.log(\"FIELD NOT FOUND:\", fieldname);\n            }\n        });\n    }\n\n    // \u0639\u0646\u062f \u0641\u062a\u062d \u0627\u0644\u0635\u0641\u062d\u0629\n    toggle_fields();\n\n    // \u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 Checkbox\n    frappe.web_form.on(\"custom_privacy_consents\", function(field, value) {\n        console.log(\"CONSENT CHANGED:\", value);\n        toggle_fields();\n    });\n};",

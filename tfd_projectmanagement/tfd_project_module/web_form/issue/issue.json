 "client_script": "frappe.web_form.after_load = () => {\n    const params = new URLSearchParams(window.location.search);\n\n    if (!params.get(\"_lang\")) {\n        params.set(\"_lang\", \"ar\");\n        window.location.replace(window.location.pathname + \"?\" + params.toString());\n        return;\n    }\n\n    const consent_field = \"custom_privacy_consents\";\n    const layout_fieldtypes = [\"Section Break\", \"Column Break\", \"Page Break\", \"Tab Break\"];\n\n    function is_checked(value) {\n        return value === true || value === 1 || value === \"1\";\n    }\n\n    function remember_original_state(df) {\n        if (df.__privacy_original_hidden === undefined) {\n            df.__privacy_original_hidden = df.hidden || 0;\n        }\n        if (df.__privacy_original_reqd === undefined) {\n            df.__privacy_original_reqd = df.reqd || 0;\n        }\n    }\n\n    function is_layout_field(df) {\n        return layout_fieldtypes.includes(df.fieldtype);\n    }\n\n    function refresh_field(df) {\n        const field = frappe.web_form.fields_dict[df.fieldname];\n        if (!field || !field.df) return;\n\n        field.df.hidden = df.hidden;\n        field.df.reqd = df.reqd;\n        field.df.hidden_due_to_dependency = false;\n\n        if (field.refresh) {\n            field.refresh();\n        }\n    }\n\n    function toggle_sections(checked) {\n        $(\".web-form .section-head, .web-form .section-title\").toggle(checked);\n        $(`[data-fieldname=\"${consent_field}\"]`).closest(\".frappe-control\").show();\n    }\n\n    function toggle_fields() {\n        const checked = is_checked(frappe.web_form.get_value(consent_field));\n\n        (frappe.web_form.fields || []).forEach((df) => {\n            if (!df.fieldname) return;\n\n            remember_original_state(df);\n\n            if (df.fieldname === consent_field || is_layout_field(df)) {\n                df.hidden = 0;\n                df.reqd = df.__privacy_original_reqd || 0;\n            } else if (checked) {\n                df.hidden = df.__privacy_original_hidden || 0;\n                df.reqd = df.__privacy_original_reqd || 0;\n            } else {\n                df.hidden = 1;\n                df.reqd = 0;\n            }\n\n            refresh_field(df);\n        });\n\n        if (checked && frappe.web_form.refresh_dependency) {\n            frappe.web_form.refresh_dependency();\n        }\n\n        toggle_sections(checked);\n    }\n\n    toggle_fields();\n    requestAnimationFrame(toggle_fields);\n    setTimeout(toggle_fields, 300);\n\n    frappe.web_form.on(consent_field, () => {\n        toggle_fields();\n        setTimeout(toggle_fields, 0);\n    });\n};",

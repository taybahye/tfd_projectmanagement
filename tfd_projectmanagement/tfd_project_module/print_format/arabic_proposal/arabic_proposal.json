 "css": ":root{\r\n  --ink:#111;\r\n  --muted:#666;\r\n  --line:#cfd6e0;\r\n  --head:#0f2e5f;\r\n  --note:#f7f9fc;\r\n  --band:#eef2f7;\r\n}\r\n\r\n@page{ size:A4; margin:12mm; }\r\n\r\nhtml,body{\r\n  height:100%;\r\n  background:#fff;\r\n  direction:rtl;\r\n  unicode-bidi:embed;\r\n}\r\n\r\nbody{\r\n  margin:0;\r\n  color:var(--ink);\r\n  font: 13px/1.6 \"Tahoma\",\"Segoe UI\",Arial,sans-serif;\r\n  text-align:right;\r\n}\r\n\r\n/* ===== \u0627\u0644\u0635\u0641\u062d\u0629 ===== */\r\n.page{\r\n  width:100%;\r\n  max-width:210mm;\r\n  margin:0 auto;\r\n  padding:6mm 0 10mm;\r\n  box-sizing:border-box;\r\n}\r\n\r\n/* ===== \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646 ===== */\r\n.h-title{\r\n  text-align:center;\r\n  color:var(--head);\r\n  font-weight:800;\r\n  font-size:18px;\r\n  margin:0 0 10px;\r\n}\r\n.subhead{\r\n  text-align:center;\r\n  color:var(--muted);\r\n  margin:-4px 0 14px;\r\n  font-size:12px;\r\n}\r\n\r\n/* ===== \u0627\u0644\u0623\u0642\u0633\u0627\u0645 ===== */\r\n.section{\r\n  margin:12px 0 0;\r\n  border:1px solid var(--line);\r\n  border-radius:6px;\r\n  overflow:hidden;\r\n}\r\n.section > .bar{\r\n  background:var(--head);\r\n  color:#fff;\r\n  padding:7px 10px;\r\n  font-weight:700;\r\n  font-size:13px;\r\n  text-align:right;\r\n}\r\n.section > .body{\r\n  padding:10px;\r\n  background:#fff;\r\n}\r\n\r\n/* ===== \u0634\u0628\u0643\u0629 \u0627\u0644\u062d\u0642\u0648\u0644 ===== */\r\n.kv{\r\n  display:grid;\r\n  grid-template-columns: 120px 1fr;  /* \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u064a\u0645\u064a\u0646 \u0636\u064a\u0642\u060c \u0627\u0644\u0642\u064a\u0645\u0629 \u064a\u0633\u0627\u0631 \u0648\u0627\u0633\u0639\u0629 */\r\n  gap:8px 10px;\r\n}\r\n.kv .k{\r\n  background:#f0f2f6;\r\n  border:1px solid var(--line);\r\n  padding:6px 8px;\r\n  font-weight:700;\r\n  border-radius:4px;\r\n  text-align:right;\r\n  font-size:12px;\r\n  line-height:1.4;\r\n  white-space:normal;\r\n  grid-column:1;\r\n}\r\n.kv .v{\r\n  border:1px solid var(--line);\r\n  background:#fff;\r\n  padding:6px 8px;\r\n  min-height:30px;\r\n  border-radius:4px;\r\n  text-align:right;\r\n  grid-column:2;\r\n}\r\n.span-2{ grid-column: 1 / -1; }\r\n\r\n.area{ min-height:110px; background:var(--note); }\r\n\r\n/* ===== \u0627\u0644\u062c\u062f\u0627\u0648\u0644 ===== */\r\n.table{\r\n  width:100%;\r\n  border-collapse:collapse;\r\n  border:1px solid var(--line);\r\n  table-layout:fixed;\r\n  margin-top:8px;\r\n  direction:rtl;\r\n}\r\n.table th, .table td{\r\n  border:1px solid var(--line);\r\n  padding:6px 6px;\r\n  vertical-align:middle;\r\n  text-align:center;\r\n  background:#fff;\r\n}\r\n.table thead th{\r\n  background:var(--band);\r\n  font-weight:700;\r\n}\r\n\r\n/* ===== checkbox \u0634\u0643\u0644 \u064a\u062f\u0648\u064a ===== */\r\n.cb{\r\n  display:inline-block;\r\n  width:12px;\r\n  height:12px;\r\n  border:1.8px solid var(--ink);\r\n  vertical-align:middle;\r\n  margin-inline-start:6px;\r\n  border-radius:2px;\r\n}\r\n\r\n/* ===== \u0645\u0644\u0627\u062d\u0638\u0627\u062a ===== */\r\n.note{\r\n  background:#fafbfd;\r\n  border:1px dashed var(--line);\r\n  padding:8px;\r\n  border-radius:4px;\r\n  color:#333;\r\n  font-size:12px;\r\n  margin-top:8px;\r\n  text-align:right;\r\n}\r\n\r\n/* ===== \u0627\u0644\u0637\u0628\u0627\u0639\u0629 ===== */\r\n@media print{\r\n  thead{ display:table-header-group; }\r\n  .avoid-break{ break-inside:avoid; page-break-inside:avoid; }\r\n  .break-before{ break-before:page; page-break-before:always; }\r\n  .section{ border-radius:0; }\r\n}\r\n\r\n/* ===== \u0645\u0648\u0628\u0627\u064a\u0644 ===== */\r\n@media (max-width: 820px){\r\n  .kv{ grid-template-columns: 1fr; }\r\n  .span-2{ grid-column:auto; }\r\n}\r\n/* ===== \u063a\u0644\u0627\u0641 \u0628\u0633\u064a\u0637 \u0628\u062f\u0648\u0646 \u0635\u0646\u0627\u062f\u064a\u0642 (\u0633\u0637\u0631 \u0644\u0644\u0643\u062a\u0627\u0628\u0629) ===== */\r\n.kv--plain{\r\n  grid-template-columns: 120px 1fr;  /* \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u064a\u0645\u064a\u0646 \u0623\u0636\u064a\u0642 */\r\n}\r\n\r\n.kv--plain .k{\r\n  background: transparent;\r\n  border: 0;\r\n  padding: 2px 0;\r\n  font-weight: 700;\r\n  font-size: 12px;\r\n}\r\n\r\n.kv--plain .v{\r\n  background: transparent;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--line);  /* \u0633\u0637\u0631 \u0641\u0642\u0637 */\r\n  min-height: 28px;\r\n  padding: 2px 0;                        /* \u0628\u062f\u0648\u0646 \u062d\u0648\u0627\u0634\u064a \u062c\u0627\u0646\u0628\u064a\u0629 */\r\n}\r\n",

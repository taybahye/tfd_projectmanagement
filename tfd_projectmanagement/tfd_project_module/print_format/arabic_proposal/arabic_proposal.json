 "html": "<!DOCTYPE html>\r\n<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<title>\u0646\u0645\u0648\u0630\u062c \u0625\u0639\u062f\u0627\u062f \u0645\u0642\u062a\u0631\u062d \u0645\u0634\u0631\u0648\u0639 (PP-003)</title>\r\n\r\n</head>\r\n<body>\r\n<div class=\"page\">\r\n\r\n  <h1 class=\"h-title\">\u0646\u0645\u0648\u0630\u062c \u0625\u0639\u062f\u0627\u062f \u0645\u0642\u062a\u0631\u062d \u0645\u0634\u0631\u0648\u0639</h1>\r\n  <p class=\"subhead\">Project Proposal \u2013 PP-003</p>\r\n\r\n<!-- ========== Cover fields ========== -->\r\n<div class=\"section\">\r\n  <div class=\"bar\">\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u0639\u0631\u064a\u0641\u064a\u0629</div>\r\n  <div class=\"body\">\r\n    <!-- \u0623\u0636\u0641 kv--plain \u0647\u0646\u0627 -->\r\n    <div class=\"kv kv--plain\">\r\n      <div class=\"k\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0634\u0631\u0648\u0639</div><div class=\"v\"></div>\r\n      <div class=\"k\">\u0645\u0642\u062f\u0645 \u0645\u0646 (\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u0638\u0645\u0629)</div><div class=\"v\"></div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n\r\n  <!-- ========== Project Information ========== -->\r\n  <div class=\"section\">\r\n    <div class=\"bar\">1) \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639</div>\r\n    <div class=\"body\">\r\n      <div class=\"kv\">\r\n        <div class=\"k\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0634\u0631\u0648\u0639</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0627\u0644\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0644\u0644\u0645\u0642\u062a\u0631\u062d</div><div class=\"v\"></div>\r\n\r\n        <div class=\"k\">\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0645\u0646\u0638\u0645\u0629</div>\r\n        <div class=\"v\">\r\n          <span class=\"cb\"></span> \u0627\u0644\u0623\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629\r\n          &nbsp;&nbsp;<span class=\"cb\"></span> \u0645\u0646\u0638\u0645\u0629 \u063a\u064a\u0631 \u062d\u0643\u0648\u0645\u064a\u0629 \u062f\u0648\u0644\u064a\u0629\r\n          &nbsp;&nbsp;<span class=\"cb\"></span> \u0645\u0646\u0638\u0645\u0629 \u063a\u064a\u0631 \u062d\u0643\u0648\u0645\u064a\u0629 \u0645\u062d\u0644\u064a\u0629\r\n          &nbsp;&nbsp;<span class=\"cb\"></span> \u0623\u062e\u0631\u0649\r\n        </div>\r\n\r\n        <div class=\"k\">\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u0644\u0645\u0646\u0638\u0645\u0629 (\u0627\u0644\u0647\u0627\u062a\u0641/\u0627\u0644\u0628\u0631\u064a\u062f)</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0645\u0642\u062f\u0645 \u0627\u0644\u0645\u0642\u062a\u0631\u062d (\u0627\u0644\u0627\u0633\u0645\u060c \u0627\u0644\u0645\u0646\u0635\u0628\u060c \u0627\u0644\u0639\u0646\u0648\u0627\u0646\u060c \u0627\u0644\u0628\u0631\u064a\u062f\u060c \u0627\u0644\u0647\u0627\u062a\u0641)</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0641\u064a \u0627\u0644\u0645\u0642\u0631 \u0627\u0644\u0631\u0626\u064a\u0633\u064a</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 (\u0627\u0644\u0642\u0631\u064a\u0629/\u0627\u0644\u062f\u0627\u0626\u0631\u0629/\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0641\u0631\u0639\u064a\u0629/\u0627\u0644\u0645\u0642\u0627\u0637\u0639\u0629/\u0627\u0644\u0645\u0646\u0637\u0642\u0629/\u0627\u0644\u062f\u0648\u0644\u0629)</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0642\u0637\u0627\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0627\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0641\u0631\u0639\u064a</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0645\u062f\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 (\u0639\u062f\u062f \u0627\u0644\u0634\u0647\u0648\u0631)</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0642\u062f\u064a\u0645</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0645\u0642\u062a\u0631\u062d</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0645\u0642\u062a\u0631\u062d</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629</div><div class=\"v\"></div>\r\n      </div>\r\n\r\n      <div class=\"kv\" style=\"margin-top:10px\">\r\n        <div class=\"k\">\u0627\u0644\u0645\u0633\u062a\u0641\u064a\u062f\u064a\u0646 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u064a\u0646</div><div class=\"v\"></div>\r\n        <div class=\"k\">\u0627\u0644\u0645\u0633\u062a\u0641\u064a\u062f\u064a\u0646 \u063a\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u064a\u0646</div><div class=\"v\"></div>\r\n      </div>\r\n\r\n      <div class=\"kv\" style=\"margin-top:10px\">\r\n        <div class=\"k\">\u0645\u0644\u062e\u0635 \u0627\u0644\u0645\u0634\u0631\u0648\u0639</div>\r\n        <div class=\"v area\"></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ========== 3) Rationale & Needs ========== -->\r\n  <div class=\"section\">\r\n    <div class=\"bar\">2) \u0645\u0628\u0631\u0631\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0648\u0623\u0633\u0633\u0647 \u0627\u0644\u0645\u0646\u0637\u0642\u064a\u0629</div>\r\n    <div class=\"body kv\">\r\n      <div class=\"k\">3.1 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0629</div><div class=\"v area\"></div>\r\n      <div class=\"k\">3.2 \u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a</div><div class=\"v area\"></div>\r\n      <div class=\"k\">3.3 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629</div><div class=\"v area\"></div>\r\n      <div class=\"k\">3.4 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0627\u0644\u0645\u062a\u062e\u0630\u0629 / \u0627\u0644\u0645\u062e\u0637\u0637 \u0644\u0647\u0627</div><div class=\"v area\"></div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ========== 4) Project description ========== -->\r\n  <div class=\"section avoid-break\">\r\n    <div class=\"bar\">3) \u0648\u0635\u0641 \u0627\u0644\u0645\u0634\u0631\u0648\u0639</div>\r\n    <div class=\"body\">\r\n      <div class=\"kv\">\r\n        <div class=\"k\">4.1 \u0627\u0644\u0647\u062f\u0641 \u0627\u0644\u0639\u0627\u0645 \u0644\u0644\u0645\u0634\u0631\u0648\u0639 \u0648\u063a\u0627\u064a\u0627\u062a\u0647</div><div class=\"v area\"></div>\r\n        <div class=\"k\">4.2 \u0648\u0635\u0641 \u0627\u0644\u062a\u062f\u062e\u0644\u0627\u062a</div><div class=\"v area\"></div>\r\n      </div>\r\n\r\n      <div class=\"kv\" style=\"margin-top:10px\">\r\n        <div class=\"k\">4.3 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0645\u0633\u062a\u0641\u064a\u062f\u064a\u0646 (\u0645\u0628\u0627\u0634\u0631\u064a\u0646/\u063a\u064a\u0631 \u0645\u0628\u0627\u0634\u0631\u064a\u0646)</div>\r\n        <div class=\"v\">\r\n          <table class=\"table\">\r\n            <thead>\r\n              <tr>\r\n                <th class=\"center\">\u0627\u0644\u0641\u0626\u0627\u062a</th>\r\n                <th class=\"center nowrap\">\u0646\u0633\u0627\u0621</th>\r\n                <th class=\"center nowrap\">\u0631\u062c\u0627\u0644</th>\r\n                <th class=\"center nowrap\">\u0641\u062a\u064a\u0627\u062a (&lt; 18)</th>\r\n                <th cl
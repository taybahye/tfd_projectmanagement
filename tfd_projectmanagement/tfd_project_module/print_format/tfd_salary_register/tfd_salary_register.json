 "font_size": 14,
 "html": "\r\n\r\n<h2>\u0643\u0634\u0641 \u0627\u0644\u0631\u0627\u062a\u0628 - Salary Slip</h2>\r\n\r\n<table>\r\n  <thead>\r\n    <tr>\r\n      <th colspan=\"6\">\u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642\u0627\u062a DUES</th>\r\n      <th colspan=\"5\">\u0627\u0644\u0627\u0633\u062a\u0642\u0637\u0627\u0639\u0627\u062a REBATE</th>\r\n      <th>\u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0627\u062a\u0628</th>\r\n      <th>\u0645\u0644\u0627\u062d\u0638\u0627\u062a</th>\r\n      <th>\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641</th>\r\n      <th>\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a</th>\r\n      <th>\u0627\u0644\u0639\u0645\u0644\u0629</th>\r\n    </tr>\r\n    <tr>\r\n      <th>\u0631\u0627\u062a\u0628 \u0623\u0633\u0627\u0633\u064a</th>\r\n      <th>\u0628\u062f\u0644 \u0645\u0638\u0647\u0631</th>\r\n      <th>\u0628\u062f\u0644 \u0645\u0648\u0627\u0635\u0644\u0627\u062a</th>\r\n      <th>\u062a\u0623\u0645\u064a\u0646 \u0627\u062c\u062a\u0645\u0627\u0639\u064a 9%</th>\r\n      <th>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0627\u062a</th>\r\n      <th>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a</th>\r\n      <th>\u063a\u064a\u0627\u0628</th>\r\n      <th>\u0633\u0644\u0641</th>\r\n      <th>\u062a\u0623\u0645\u064a\u0646 \u0627\u062c\u062a\u0645\u0627\u0639\u064a 15%</th>\r\n      <th>\u0636\u0631\u064a\u0628\u0629</th>\r\n      <th>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0627\u0633\u062a\u0642\u0637\u0627\u0639\u0627\u062a</th>\r\n      <th>\u0627\u0644\u0635\u0627\u0641\u064a</th>\r\n      <th>\u0645\u0644\u0627\u062d\u0638\u0627\u062a</th>\r\n      <th>{{ doc.employee_name }}</th>\r\n      <th>{{ doc.designation }}</th>\r\n      <th>$</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    <tr>\r\n      <td>{{ doc.base }}</td>\r\n      <td>{{ doc. to_reb_amd }}</td>\r\n      <td>{{ doc.get(\"transport_allowance\", \"0.00\") }}</td>\r\n      <td>{{ doc.get(\"social_insurance_9\", \"0.00\") }}</td>\r\n      <td>{{ doc.gross_pay }}</td>\r\n      <td>{{ doc.total_earnings }}</td>\r\n      <td>{{ doc.get(\"penalty\", \"0.00\") }}</td>\r\n      <td>{{ doc.loan_repayment }}</td>\r\n      <td>{{ doc.get(\"social_insurance_15\", \"0.00\") }}</td>\r\n      <td>{{ doc.get(\"tax\", \"0.00\") }}</td>\r\n      <td>{{ doc.total_deductions }}</td>\r\n      <td>{{ doc.net_pay }}</td>\r\n      <td>{{ doc.remarks or \"\" }}</td>\r\n      <td>{{ doc.employee_name }}</td>\r\n      <td>{{ doc.designation }}</td>\r\n      <td>$</td>\r\n    </tr>\r\n  </tbody>\r\n</table>\r\n",
